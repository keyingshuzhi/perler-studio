APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.3.0
DATA_DIR=/app/data
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_PIXELS=50000000
MAX_GRID_WIDTH=500
MAX_GRID_HEIGHT=500
DEFAULT_PALETTE=mard-291
DEFAULT_DISTANCE_METHOD=ciede2000
DEFAULT_BEAD_SIZE_MM=5
DEFAULT_WASTE_RATE=0.05
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_PATH=/app/data/perler-studio.db
# Set these to the owner of the host data directory (for example `id -u` and `id -g`).
DATA_UID=1000
DATA_GID=1000
# Replace with a long, random value before public deployment.
AUTH_SECRET=replace-with-a-long-random-production-secret
AUTH_SESSION_DAYS=30
# Optional: claim filesystem projects created before account ownership was introduced.
LEGACY_DATA_OWNER_EMAIL=
# A built-in administrator is created automatically: account admin / password admin.
# Change this password immediately after the first login. The setting below is optional
# and can additionally grant administrator rights to newly registered email accounts.
INITIAL_ADMIN_EMAILS=admin@example.com
