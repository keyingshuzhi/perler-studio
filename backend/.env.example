APP_NAME=Perler Studio API
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.3.1

# This is relative to backend/ when running uvicorn locally.
DATA_DIR=../data
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_PIXELS=50000000
MAX_GRID_WIDTH=500
MAX_GRID_HEIGHT=500
DEFAULT_PALETTE=mard-291
DEFAULT_DISTANCE_METHOD=ciede2000
DEFAULT_BEAD_SIZE_MM=5
DEFAULT_WASTE_RATE=0.05
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_PATH=../data/perler-studio.db
AUTH_SECRET=perler-studio-development-secret-change-before-production
AUTH_SESSION_DAYS=30
# Optional: claim filesystem projects created before account ownership was introduced.
LEGACY_DATA_OWNER_EMAIL=
# Bootstrap administrator email(s), comma-separated. Remove after first setup.
INITIAL_ADMIN_EMAILS=admin@example.com
